[Default Applications]
inode/directory=org.kde.dolphin.desktop;

# Archives and compressed files
application/zip=org.kde.ark.desktop;
application/x-7z-compressed=org.kde.ark.desktop;
application/vnd.rar=org.kde.ark.desktop;
application/x-rar=org.kde.ark.desktop;
application/x-rar-compressed=org.kde.ark.desktop;
application/x-tar=org.kde.ark.desktop;
application/x-compressed-tar=org.kde.ark.desktop;
application/x-bzip-compressed-tar=org.kde.ark.desktop;
application/x-bzip2-compressed-tar=org.kde.ark.desktop;
application/x-xz-compressed-tar=org.kde.ark.desktop;
application/x-lzma-compressed-tar=org.kde.ark.desktop;
application/x-lzip-compressed-tar=org.kde.ark.desktop;
application/x-lz4-compressed-tar=org.kde.ark.desktop;
application/x-zstd-compressed-tar=org.kde.ark.desktop;
application/x-tarz=org.kde.ark.desktop;
application/gzip=org.kde.ark.desktop;
application/x-bzip=org.kde.ark.desktop;
application/x-bzip2=org.kde.ark.desktop;
application/x-xz=org.kde.ark.desktop;
application/x-lzma=org.kde.ark.desktop;
application/x-lzip=org.kde.ark.desktop;
application/x-lz4=org.kde.ark.desktop;
application/zstd=org.kde.ark.desktop;
application/x-compress=org.kde.ark.desktop;
application/x-cpio=org.kde.ark.desktop;
application/vnd.ms-cab-compressed=org.kde.ark.desktop;

# Web pages and links
x-scheme-handler/http=firefox.desktop;
x-scheme-handler/https=firefox.desktop;
text/html=firefox.desktop;
application/xhtml+xml=firefox.desktop;

# Text and source files
text/plain=org.kde.kate.desktop;
application/x-zerosize=org.kde.kate.desktop;
application/json=org.kde.kate.desktop;
application/ld+json=org.kde.kate.desktop;
application/xml=org.kde.kate.desktop;
text/xml=org.kde.kate.desktop;
application/yaml=org.kde.kate.desktop;
application/toml=org.kde.kate.desktop;
text/markdown=org.kde.kate.desktop;
text/x-python=org.kde.kate.desktop;
application/x-shellscript=org.kde.kate.desktop;
text/javascript=org.kde.kate.desktop;
text/css=org.kde.kate.desktop;

# Documents and books
application/pdf=okularApplication_pdf.desktop;
application/epub+zip=okularApplication_epub.desktop;
application/vnd.oasis.opendocument.text=org.libreoffice.LibreOffice.writer.desktop;
application/vnd.oasis.opendocument.text-template=org.libreoffice.LibreOffice.writer.desktop;
application/msword=org.libreoffice.LibreOffice.writer.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.document=org.libreoffice.LibreOffice.writer.desktop;
application/rtf=org.libreoffice.LibreOffice.writer.desktop;
text/rtf=org.libreoffice.LibreOffice.writer.desktop;
application/vnd.oasis.opendocument.spreadsheet=org.libreoffice.LibreOffice.calc.desktop;
application/vnd.ms-excel=org.libreoffice.LibreOffice.calc.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=org.libreoffice.LibreOffice.calc.desktop;
text/csv=org.libreoffice.LibreOffice.calc.desktop;
application/vnd.oasis.opendocument.presentation=org.libreoffice.LibreOffice.impress.desktop;
application/vnd.ms-powerpoint=org.libreoffice.LibreOffice.impress.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=org.libreoffice.LibreOffice.impress.desktop;
application/vnd.oasis.opendocument.graphics=org.libreoffice.LibreOffice.draw.desktop;

# Image viewing; editable GIMP/Photoshop documents use GIMP
image/png=org.kde.koko.desktop;
image/jpeg=org.kde.koko.desktop;
image/gif=org.kde.koko.desktop;
image/webp=org.kde.koko.desktop;
image/avif=org.kde.koko.desktop;
image/svg+xml=org.kde.koko.desktop;
image/bmp=org.kde.koko.desktop;
image/tiff=org.kde.koko.desktop;
image/heif=org.kde.koko.desktop;
image/heic=org.kde.koko.desktop;
image/vnd.microsoft.icon=org.kde.koko.desktop;
image/x-xcf=org.gimp.GIMP.desktop;
image/vnd.adobe.photoshop=org.gimp.GIMP.desktop;

# Music
audio/mpeg=org.fooyin.fooyin.desktop;
audio/flac=org.fooyin.fooyin.desktop;
audio/x-flac=org.fooyin.fooyin.desktop;
audio/ogg=org.fooyin.fooyin.desktop;
audio/opus=org.fooyin.fooyin.desktop;
audio/mp4=org.fooyin.fooyin.desktop;
audio/aac=org.fooyin.fooyin.desktop;
audio/x-wav=org.fooyin.fooyin.desktop;
audio/vnd.wave=org.fooyin.fooyin.desktop;
audio/x-ms-wma=org.fooyin.fooyin.desktop;
audio/x-ape=org.fooyin.fooyin.desktop;
audio/x-vorbis+ogg=org.fooyin.fooyin.desktop;
audio/x-mpegurl=org.fooyin.fooyin.desktop;
audio/x-scpls=org.fooyin.fooyin.desktop;
audio/wav=org.fooyin.fooyin.desktop;
audio/x-matroska=org.fooyin.fooyin.desktop;

# Video
video/mp4=mpv.desktop;
video/x-matroska=mpv.desktop;
video/webm=mpv.desktop;
video/mpeg=mpv.desktop;
video/quicktime=mpv.desktop;
video/x-msvideo=mpv.desktop;
video/vnd.avi=mpv.desktop;
video/x-ms-wmv=mpv.desktop;
video/x-flv=mpv.desktop;
video/ogg=mpv.desktop;
video/mp2t=mpv.desktop;
video/x-m4v=mpv.desktop;
video/3gpp=mpv.desktop;
video/3gpp2=mpv.desktop;
video/x-ms-asf=mpv.desktop;
video/vnd.rn-realvideo=mpv.desktop;
video/divx=mpv.desktop;
video/vnd.divx=mpv.desktop;
video/mp4v-es=mpv.desktop;
video/x-matroska-3d=mpv.desktop;

# Mail, calendars and torrents
x-scheme-handler/mailto=org.mozilla.Thunderbird.desktop;
message/rfc822=org.mozilla.Thunderbird.desktop;
text/calendar=org.mozilla.Thunderbird.desktop;
text/vcard=org.mozilla.Thunderbird.desktop;
x-scheme-handler/webcal=org.mozilla.Thunderbird.desktop;
x-scheme-handler/webcals=org.mozilla.Thunderbird.desktop;
application/x-bittorrent=org.qbittorrent.qBittorrent.desktop;
x-scheme-handler/magnet=org.qbittorrent.qBittorrent.desktop;

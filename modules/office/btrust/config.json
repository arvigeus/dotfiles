{
    "packages": [
        "pcsclite",
        "ccid",
        "nss",
        "opensc",
        "pcsc-tools"
    ],
    "extra": {
        "aur_packages": [
            "btrustbiss",
            "sac-core"
        ],
        "browsers": {
            "firefox": {
                "policies": {
                    "LocalNetworkAccess": {
                        "SkipDomains": [
                            "wsp.b-trust.bg",
                            "test.b-trust.bg"
                        ]
                    },
                    "SecurityDevices": {
                        "Add": {
                            "B-Trust IDPrime": "/usr/lib/pkcs11/libIDPrimePKCS11.so"
                        }
                    },
                    "Certificates": {
                        "Install": [
                            "/opt/btrustbiss/lib/app/BTrustCA/root/B-TrustRootQCA.cer",
                            "/opt/btrustbiss/lib/app/BTrustCA/root/B-TrustRootACA.cer",
                            "/opt/btrustbiss/lib/app/BTrustCA/root/RootCA5_PEM.cer",
                            "/opt/btrustbiss/lib/app/BTrustCA/root/biss-localhost-linux.cer"
                        ]
                    },
                    "Preferences": {
                        "security.osclientcerts.autoload": {
                            "Value": false,
                            "Status": "locked"
                        }
                    }
                }
            }
        },
        "private": {
            "files": [
                "home/.local/share/syntaxis-signing",
                "home/AppData/Roaming/BISS/Settings.xml"
            ]
        }
    }
}

#!/usr/bin/env bash
# Keep pcscd on demand after the AUR install hook enables it.
set -Eeuo pipefail
systemctl disable pcscd.service pcscd.socket
# Only a booted system can stop units; keep them during an active signing session.
if [[ -d /run/systemd/system ]] && ! systemctl is-active --quiet btrust.target; then
    systemctl stop pcscd.service pcscd.socket
fi

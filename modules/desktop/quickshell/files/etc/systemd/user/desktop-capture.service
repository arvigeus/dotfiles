[Unit]
Description=Desktop screen and speech capture controls
Requires=desktop-capture.socket
After=desktop-capture.socket graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
UMask=0077
ExecStart=/usr/bin/python3 "%E/quickshell/desktop/drawers/capture/recorder.py"
Slice=session.slice
KillMode=mixed
TimeoutStopSec=25s

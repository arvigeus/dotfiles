[Unit]
Description=Desktop screen recording controls
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=/usr/bin/python3 -B "%E/quickshell/desktop/drawers/capture/recorder.py" --serve
Slice=session.slice
KillMode=mixed
TimeoutStopSec=20s

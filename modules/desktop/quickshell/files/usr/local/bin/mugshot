#!/usr/bin/python3
"""Launch Mugshot for account name/photo editing without legacy sudo probes."""
import locale

from mugshot_lib import SudoDialog

# Mugshot 0.4.3 probes sudo twice at startup for legacy chfn phone fields.
# Closing those password prompts counts as failed authentication with pam_faillock.
# Name/photo editing uses AccountsService and needs neither chfn nor sudo.
# Returning false also disables legacy name editing if AccountsService is absent.
SudoDialog.check_dependencies = lambda commands=(): False

import mugshot

locale.textdomain('mugshot')
mugshot.main()

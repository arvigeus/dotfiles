#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
    printf '%s\n' "$*" >&2
    [[ ${save:-auto} == false ]] || notify-send 'Screenshot' "$*" || true
    exit 1
}

mode=${1:-}
[[ $# -gt 0 ]] && shift
edit=auto
save=auto
report=false
output=
editor=${DESKTOP_SCREENSHOT_EDITOR:-ksnip}
case $mode in
    edit)
        mode=region
        edit=true
        ;;
    region | window | output | active-window) ;;
    *) fail 'Choose edit, region, window, active-window, or output.' ;;
esac
while [[ $# -gt 0 ]]; do
    case $1 in
        --output)
            [[ $# -ge 2 && -n $2 && $mode == output ]] || fail '--output needs a display name in output mode.'
            output=$2
            shift 2
            ;;
        --edit)
            edit=true
            shift
            ;;
        --no-edit)
            edit=false
            shift
            ;;
        --save)
            save=true
            shift
            ;;
        --no-save)
            save=false
            shift
            ;;
        --report)
            report=true
            shift
            ;;
        *) fail "Unknown option: $1" ;;
    esac
done
config=${XDG_CONFIG_HOME:-$HOME/.config}
[[ $config == /* ]] || config=$HOME/.config
if [[ $save == auto ]]; then
    preference=on
    if [[ -f $config/quickshell/desktop/screenshot-save ]]; then
        read -r preference < "$config/quickshell/desktop/screenshot-save" || true
    fi
    if [[ $preference == off ]]; then save=false; else save=true; fi
fi
if [[ $edit == auto ]]; then
    preference=on
    if [[ -f $config/quickshell/desktop/screenshot-editor ]]; then
        read -r preference < "$config/quickshell/desktop/screenshot-editor" || true
    fi
    if [[ $preference == off ]]; then edit=false; else edit=true; fi
fi
$save || edit=false

command -v grim > /dev/null || fail 'Install grim to take screenshots.'
if $edit; then
    case $editor in
        ksnip | satty) ;;
        *) fail 'Choose ksnip or satty as DESKTOP_SCREENSHOT_EDITOR.' ;;
    esac
    command -v "$editor" > /dev/null || fail "Install $editor to edit screenshots."
fi

# Window boxes for slurp, clipped to their monitor's logical area so that
# scrolled-off columns add no transparent margins. Reads clients or one window.
window_boxes() {
    jq -r --argjson monitors "$(hyprctl -j monitors)" --arg scope "$1" '
        def box: . as $window | first($monitors[] | select(.id == $window.monitor)) as $m
            | (if $m.transform % 2 == 1 then [$m.height, $m.width] else [$m.width, $m.height] end
               | map(. / $m.scale)) as [$width, $height]
            | ([$window.at[0], $m.x] | max) as $x | ([$window.at[1], $m.y] | max) as $y
            | (([$window.at[0] + $window.size[0], $m.x + $width] | min) - $x | floor) as $w
            | (([$window.at[1] + $window.size[1], $m.y + $height] | min) - $y | floor) as $h
            | select($w > 0 and $h > 0) | "\($x),\($y) \($w)x\($h)";
        if $scope == "active" then box else
            [$monitors[] | .activeWorkspace.id, .specialWorkspace.id] as $visible
            | .[] | select(.mapped and (.hidden | not) and (.workspace.id as $id | any($visible[]; . == $id)))
            | box
        end'
}

# Select before capturing: cancelling leaves no image and the clipboard unchanged.
# Slurp reads boxes from any non-terminal stdin before it shows its overlay.
case $mode in
    region) geometry=$(slurp -d < /dev/null) || exit 0 ;;
    window) geometry=$(hyprctl -j clients | window_boxes visible | slurp -r) || exit 0 ;;
    active-window)
        geometry=$(hyprctl -j activewindow | window_boxes active)
        [[ -n $geometry ]] || fail 'There is no window to capture.'
        ;;
    output)
        [[ -n $output ]] || output=$(hyprctl -j monitors | jq -r 'first(.[] | select(.focused)).name // empty')
        ;;
esac
# Whole outputs are captured natively, including their transform.
if [[ $mode == output ]]; then target=(-o "$output"); else target=(-g "$geometry"); fi

if ! $save; then
    # Buffer in memory so a failed or truncated capture cannot replace the
    # clipboard. No temporary image is written and no notification is sent.
    grim "${target[@]}" - | python3 -c '
import subprocess, sys
image = sys.stdin.buffer.read()
if not image.startswith(b"\x89PNG\r\n\x1a\n") or not image.endswith(
    b"\0\0\0\0IEND\xae\x42\x60\x82"
):
    raise SystemExit(1)
subprocess.run(["wl-copy", "--type", "image/png"], input=image, check=True)
if sys.argv[1] == "true":
    print("clipboard")
' "$report" || fail 'Could not copy the screenshot to the clipboard.'
    exit 0
fi

pictures=$(xdg-user-dir PICTURES) || pictures=$HOME/Pictures
folder=${pictures:-$HOME/Pictures}/Screenshots
mkdir -p -- "$folder"
filename="Screenshot-$(date +%Y-%m-%d-%H%M%S-%N).png"
image=$folder/$filename
if ! grim "${target[@]}" "$image" || [[ ! -s $image ]]; then
    rm -f -- "$image"
    [[ $mode != output ]] || fail 'Could not capture the display. It may have disconnected.'
    fail 'Could not capture the screenshot.'
fi
wl-copy --type image/png < "$image" || true
$report && printf '%s\n' "$image"
if ! $edit; then
    notify-send -a Screenshot -i "$image" 'Screenshot saved' \
        "Saved as $filename and copied to the clipboard." || true
    exit 0
fi
case $editor in
    ksnip) editor_args=(ksnip --edit "$image") ;;
    satty)
        # shellcheck disable=SC2054 # Satty takes comma-separated action lists.
        editor_args=(satty --filename "$image" --output-filename "$image"
            --copy-command 'wl-copy --type image/png'
            --actions-on-enter save-to-file,save-to-clipboard,exit
            --actions-on-escape exit)
        ;;
esac
if $report; then
    # The reporting caller waits for this script to exit, and an editor left in
    # its service would be killed when that service restarts.
    uwsm app -t service -- "${editor_args[@]}" > /dev/null || fail "Could not open $editor."
else
    exec "${editor_args[@]}"
fi

#!/usr/bin/env bash
# Hypridle hooks backed by the shell's display helper. The helper exits 0 to
# allow and 1 to defer (Keep awake or a pause). It prints "defer" with the 1,
# because Python also exits 1 when the helper crashes or fails to import.
set -uo pipefail
decision=$(python3 "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/desktop/drawers/displays/comfort.py" "$@")
status=$?
if ((status == 0)) || [[ $status:$decision == 1:defer ]]; then
    exit "$status"
fi
# A broken helper must not leave the desktop unlocked, nor suspend it unexpectedly.
if [[ ${1-} == allow-lock ]]; then
    exit 0
fi
exit 2

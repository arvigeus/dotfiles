#!/usr/bin/env python3
"""Supervise the TTY1 desktop/gaming session and request one-shot transitions."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import select
import shutil
import signal
import subprocess
import sys
import threading
import time


MODES = ('desktop', 'gaming')
STARTUP_TIMEOUT = 45
DESKTOP = ['uwsm', 'start', '-e', '-D', 'Hyprland', 'hyprland.desktop']
STOP = dict(desktop=['uwsm', 'stop'], gaming=['steam', '-shutdown'])


def runtime_directory():
    # The runtime directory is cleared at logout and reboot, so a request can
    # never choose the mode of a later login.
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime:
        raise ValueError('XDG_RUNTIME_DIR is not set.')
    return Path(runtime) / 'session-mode'


def gaming_available():
    return all(shutil.which(command) for command in ('gaming-session', 'gamescope', 'steam'))


def current_mode(directory):
    """Return the supervised mode, or None when no supervisor holds its lock."""
    try:
        with (directory / 'current').open() as current:
            try:
                fcntl.flock(current, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                mode = current.read().strip()
                return mode if mode in MODES else None
            return None
    except FileNotFoundError:
        return None


def request_mode(directory, mode):
    if mode == 'gaming' and not gaming_available():
        raise ValueError('Install Gamescope and Steam to enter gaming mode.')
    current = current_mode(directory)
    if current is None:
        raise ValueError('Session switching requires the TTY1 session supervisor.')
    request = directory / 'next'
    staged = directory / f'.next-{os.getpid()}'
    staged.write_text(mode)
    os.replace(staged, request)
    # The supervisor reads the request when the stopped session exits. Stopping
    # the desktop usually terminates this caller too; only a reported failure
    # withdraws the request.
    if subprocess.run(STOP[current], check=False).returncode > 0:
        request.unlink(missing_ok=True)
        raise ValueError('Could not stop the current session.')


def take_request(directory):
    request = directory / 'next'
    try:
        mode = request.read_text().strip()
    except FileNotFoundError:
        return None
    request.unlink(missing_ok=True)
    return mode if mode in MODES else None


class Supervisor:
    def __init__(self, directory):
        self.directory = directory
        self.child = None
        self.stopping = threading.Event()

    def stop(self, *_):
        # Logout or shutdown: end the current session and start no other.
        self.stopping.set()
        if self.child:
            self.child.send_signal(signal.SIGTERM)

    def gaming(self):
        ready, write = os.pipe()
        with os.fdopen(ready, 'rb', buffering=0) as ready:
            try:
                self.child = subprocess.Popen(['gaming-session'], pass_fds=(write,),
                                              env=dict(os.environ, SESSION_MODE_READY_FD=str(write)))
            finally:
                os.close(write)
            # Gamescope reports readiness through the inherited descriptor.
            pidfd = os.pidfd_open(self.child.pid)
            try:
                readable = select.select([ready, pidfd], [], [], STARTUP_TIMEOUT)[0]
            finally:
                os.close(pidfd)
            if not readable:
                print('Gaming startup timed out; returning to desktop.', file=sys.stderr, flush=True)
                self.child.terminate()
                try:
                    self.child.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    self.child.kill()
        return self.child.wait()

    def run(self):
        self.directory.mkdir(mode=0o700, exist_ok=True)
        with (self.directory / 'current').open('a+') as current:
            fcntl.flock(current, fcntl.LOCK_EX | fcntl.LOCK_NB)
            (self.directory / 'next').unlink(missing_ok=True)
            mode, delay = 'desktop', 1
            while not self.stopping.is_set():
                current.truncate(0)
                current.write(mode)
                current.flush()
                started = time.monotonic()
                try:
                    if mode == 'gaming':
                        self.gaming()
                    else:
                        self.child = subprocess.Popen(DESKTOP)
                        self.child.wait()
                except (OSError, subprocess.SubprocessError) as error:
                    print(f'{mode} session failed: {error}', file=sys.stderr, flush=True)
                finally:
                    self.child = None
                requested = take_request(self.directory)
                # Repeated desktop failures back off rather than spinning.
                if mode == 'desktop' and not requested and time.monotonic() - started < 5:
                    self.stopping.wait(delay)
                    delay = min(10, delay * 2)
                else:
                    delay = 1
                # Steam Exit, a crash or a failed gaming start returns to desktop.
                mode = requested or 'desktop'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('run', 'status', *MODES))
    args = parser.parse_args()
    try:
        directory = runtime_directory()
        if args.action == 'run':
            supervisor = Supervisor(directory)
            for sig in (signal.SIGTERM, signal.SIGHUP):
                signal.signal(sig, supervisor.stop)
            # Ctrl+C on the console must not end the login. A Python handler,
            # unlike SIG_IGN, is reset to the default in the sessions it starts.
            signal.signal(signal.SIGINT, lambda *_: None)
            supervisor.run()
        elif args.action == 'status':
            available = current_mode(directory) is not None
            print(json.dumps(dict(available=available, gaming=available and gaming_available())))
        else:
            request_mode(directory, args.action)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())

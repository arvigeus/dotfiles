#!/usr/bin/env python3
"""Supervise the TTY1 desktop/gaming session and request one-shot transitions."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import select
import shutil
import signal
import subprocess
import sys
import time

MODES = ('desktop', 'gaming')
STARTUP_TIMEOUT = 45
STOP_TIMEOUT = 20
DESKTOP = ['uwsm', 'start', '-e', '-D', 'Hyprland', 'hyprland.desktop']
STOP = dict(desktop=['uwsm', 'stop'], gaming=['steam', '-shutdown'])


def runtime_directory():
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime:
        raise ValueError('XDG_RUNTIME_DIR is not set.')
    return Path(runtime) / 'session-mode'


def gaming_available():
    return all(shutil.which(command) for command in ('gaming-session', 'gamescope', 'steam'))


def owner(directory):
    """Read the mode and PID only while the supervisor holds its owner lock."""
    try:
        with (directory / 'current').open() as current:
            try:
                fcntl.flock(current, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                value = json.load(current)
                if value.get('mode') in MODES and type(value.get('pid')) is int and value['pid'] > 1:
                    return value
    except (FileNotFoundError, ValueError, AttributeError):
        pass
    return None


def current_mode(directory):
    value = owner(directory)
    return value['mode'] if value else None


def request_mode(directory, mode):
    if mode == 'gaming':
        if not gaming_available():
            raise ValueError('Install Gamescope and Steam to enter gaming mode.')
        result = subprocess.run(['gaming-session', '--check'], capture_output=True, text=True, timeout=10)
        if result.returncode:
            raise ValueError(result.stderr.strip() or 'Gaming session preflight failed.')
    with (directory / 'request.lock').open('a') as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        current = owner(directory)
        if current is None:
            raise ValueError('Session switching requires the TTY1 session supervisor.')
        request = directory / 'next'
        staged = directory / f'.next-{os.getpid()}'
        try:
            staged.write_text(mode)
            os.replace(staged, request)
            os.kill(current['pid'], signal.SIGUSR1)
        except OSError:
            request.unlink(missing_ok=True)
            raise
        finally:
            staged.unlink(missing_ok=True)


def take_request(directory):
    request = directory / 'next'
    try:
        mode = request.read_text().strip()
    except FileNotFoundError:
        return None
    request.unlink(missing_ok=True)
    return mode if mode in MODES else None


class Supervisor:
    def __init__(self, directory):
        self.directory = directory
        self.child = None
        self.stopping = False
        self.wake_read, self.wake_write = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)

    def wake(self, sig, *_):
        if sig != signal.SIGUSR1:
            self.stopping = True
        try:
            os.write(self.wake_write, b'!')
        except BlockingIOError:
            pass

    def stop_child(self, mode):
        try:
            subprocess.run(STOP[mode], check=False, timeout=8)
        except (OSError, subprocess.SubprocessError) as error:
            print(f'Session stop: {error}', file=sys.stderr, flush=True)
        try:
            self.child.wait(timeout=STOP_TIMEOUT)
        except subprocess.TimeoutExpired:
            for sig, timeout in ((signal.SIGTERM, 5), (signal.SIGKILL, None)):
                try:
                    os.killpg(self.child.pid, sig)
                except ProcessLookupError:
                    pass
                try:
                    self.child.wait(timeout=timeout)
                    break
                except subprocess.TimeoutExpired:
                    pass

    def run_once(self, mode):
        ready = write = pidfd = None
        env = dict(os.environ)
        for key in ('WAYLAND_DISPLAY', 'DISPLAY', 'HYPRLAND_INSTANCE_SIGNATURE', 'XDG_CURRENT_DESKTOP',
                    'XDG_SESSION_DESKTOP', 'IN_UWSM_ENV_PRELOADER'):
            env.pop(key, None)
        command = DESKTOP
        if mode == 'gaming':
            ready, write = os.pipe2(os.O_CLOEXEC)
            env['SESSION_MODE_READY_FD'] = str(write)
            command = ['gaming-session']
        try:
            self.child = subprocess.Popen(command, env=env, process_group=0,
                                          pass_fds=() if write is None else (write,))
            if write is not None:
                os.close(write)
                write = None
            if os.isatty(0):
                signal.signal(signal.SIGTTOU, signal.SIG_IGN)
                os.tcsetpgrp(0, self.child.pid)
            pidfd = os.pidfd_open(self.child.pid)
            deadline = time.monotonic() + STARTUP_TIMEOUT
            while True:
                if self.stopping:
                    self.stop_child(mode)
                    return None
                requested = take_request(self.directory)
                if requested:
                    self.stop_child(mode)
                    return requested
                watched = [pidfd, self.wake_read] + ([] if ready is None else [ready])
                timeout = None if ready is None else max(0, deadline - time.monotonic())
                readable = select.select(watched, [], [], timeout)[0]
                if self.wake_read in readable:
                    os.read(self.wake_read, 4096)
                    continue
                if pidfd in readable:
                    self.child.wait()
                    return take_request(self.directory)
                if ready is not None:
                    if ready in readable and os.read(ready, 4096):
                        os.close(ready)
                        ready = None
                    else:
                        print('Gaming startup timed out or closed its readiness pipe; returning to desktop.', file=sys.stderr, flush=True)
                        self.stop_child(mode)
                        return None
        finally:
            if self.child and self.child.poll() is None:
                self.stop_child(mode)
            if os.isatty(0):
                os.tcsetpgrp(0, os.getpgrp())
            for fd in (ready, write, pidfd):
                if fd is not None:
                    os.close(fd)
            self.child = None

    def run(self):
        try:
            self.directory.mkdir(mode=0o700, exist_ok=True)
            with (self.directory / 'current').open('a+') as current:
                fcntl.flock(current, fcntl.LOCK_EX | fcntl.LOCK_NB)
                (self.directory / 'next').unlink(missing_ok=True)
                mode, delay = 'desktop', 1
                while not self.stopping:
                    current.seek(0)
                    current.truncate()
                    json.dump(dict(mode=mode, pid=os.getpid()), current)
                    current.flush()
                    started = time.monotonic()
                    requested = None
                    try:
                        requested = self.run_once(mode)
                    except (OSError, subprocess.SubprocessError) as error:
                        print(f'{mode} session failed: {error}', file=sys.stderr, flush=True)
                    if mode == 'desktop' and not requested and time.monotonic() - started < 5 and not self.stopping:
                        select.select([self.wake_read], [], [], delay)
                        delay = min(10, delay * 2)
                    else:
                        delay = 1
                    # Steam Exit, a crash or a failed gaming start returns to desktop.
                    mode = requested or 'desktop'
        finally:
            os.close(self.wake_read)
            os.close(self.wake_write)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('run', 'status', *MODES))
    args = parser.parse_args()
    try:
        directory = runtime_directory()
        if args.action == 'run':
            supervisor = Supervisor(directory)
            for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGUSR1):
                signal.signal(sig, supervisor.wake)
            # A handler is reset to the default in children, unlike SIG_IGN.
            signal.signal(signal.SIGINT, lambda *_: None)
            supervisor.run()
        elif args.action == 'status':
            available = current_mode(directory) is not None
            print(json.dumps(dict(available=available, gaming=available and gaming_available())))
        else:
            request_mode(directory, args.action)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())

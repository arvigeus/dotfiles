#!/usr/bin/env bash
set -euo pipefail
data_home=${XDG_DATA_HOME:-${HOME:?HOME must be set}/.local/share}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
exec /usr/bin/code-oss \
    --extensions-dir "$data_home/vscode-oss/extensions" \
    --shared-data-dir "$state_home/vscode-oss/shared-data" "$@"
# FIXME: https://github.com/microsoft/vscode/issues/162712

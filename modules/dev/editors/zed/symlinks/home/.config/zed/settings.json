{
    "cli_default_open_behavior": "existing_window",
    "git_panel": {
        "group_by": "staging",
        "tree_view": true
    },
    "git": {
        "inline_blame": {
            "enabled": false
        }
    },
    "diagnostics": {
        "inline": {
            "enabled": true
        }
    },
    "agent": {
        "notify_when_agent_waiting": "primary_screen",
        "play_sound_when_agent_done": "when_hidden"
    },
    "ui_font_family": "Noto Sans",
    "buffer_font_family": "Noto Sans Mono",
    "ui_font_size": 15,
    "buffer_font_size": 15,
    "theme": {
        "dark": "Dotfiles Dark",
        "light": "Dotfiles Light",
        "mode": "system"
    },
    "auto_install_extensions": {
        "html": true,
        "basher": true,
        "dockerfile": true,
        "stylelint": true,
        "just": true,
        "crates-lsp": true,
        "csharp": true,
        "graphql": true,
        "toml": true,
        "comment": true,
        "env": true,
        "git-firefly": true,
        "harper": true,
        "oxc": true,
        "vue": true,
        "mdx": true,
        "scss": true
    },
    "file_types": {
        "Dockerfile": [
            "Dockerfile.*",
            "Containerfile.*"
        ]
    },
    "lsp": {
        "oxlint": {
            "initialization_options": {
                "settings": {
                    "run": "onType",
                    "fixKind": "safe_fix",
                    "disableNestedConfig": true
                }
            }
        },
        "oxfmt": {
            "initialization_options": {
                "settings": {
                    "run": "onSave",
                    "fmt.configPath": null
                }
            }
        }
    },
    "languages": {
        "JavaScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "language_servers": [
                "oxlint",
                "oxfmt",
                "!eslint",
                "..."
            ],
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                },
                {
                    "code_action": "source.fixAll.oxc"
                }
            ]
        },
        "TypeScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "language_servers": [
                "oxlint",

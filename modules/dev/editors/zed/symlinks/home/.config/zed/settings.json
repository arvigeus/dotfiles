{
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "agent": {
    "notify_when_agent_waiting": true,
    "play_sound_when_agent_done": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system"
  },
  "auto_install_extensions": {
    "html": true,
    "basher": true,
    "dockerfile": true,
    "stylelint": true,
    "deno": true,
    "just": true,
    "crates-lsp": true,
    "csharp": true,
    "graphql": true,
    "toml": true,
    "comment": true,
    "env": true,
    "git-firefly": true,
    "harper": true,
    "oxc": true
  },
  "file_types": {
    "Dockerfile": [
      "Dockerfile.*",
      "Containerfile.*"
    ]
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "disableNestedConfig": true
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "run": "onSave",
          "fmt.configPath": null
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "language_servers": [
        "oxlint",
        "oxfmt",
        "!eslint",
        "..."
      ],
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ]
    },
    "JSX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "language_servers": [
        "oxlint",

[Unit]
Description=Unlock desktop credentials for autologin
Requires=gnome-keyring-daemon.service
After=gnome-keyring-daemon.service
PartOf=gnome-keyring-daemon.service
Before=graphical-session-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/secret-service-unlock
RemainAfterExit=yes
UMask=0077
TimeoutStartSec=30s

[Install]
WantedBy=gnome-keyring-daemon.service

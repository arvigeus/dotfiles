#!/usr/bin/python3 -I
"""Runtime-only firewalld TCP/IPv4 openings for the desktop Ports controls.

Reads one JSON request from stdin and prints one JSON response. Authorization is
firewalld's polkit check; this client runs as the calling user.

It calls firewalld's runtime zone interface over D-Bus, the same methods and
polkit actions firewall-cmd uses, without starting firewall-cmd's Python client
for every query. python-gobject is a firewalld dependency.
"""
import ipaddress
import json
import re
import subprocess
import sys

FIREWALLD = 'org.fedoraproject.FirewallD1'
ZONE = FIREWALLD + '.zone'
IP = '/usr/bin/ip'
INTERFACE = re.compile(r'[A-Za-z0-9_][A-Za-z0-9_.-]{0,14}')
RULE = re.compile(r'rule family="ipv4" source address="([0-9./]+)" destination address="([0-9.]+)" '
                  r'port port="([0-9]+)" protocol="tcp" accept')


class PortError(Exception):
    """A failure the drawer can show."""


def dbus(method, signature=None, *args):
    """Call one runtime zone method and return its unpacked reply tuple."""
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    # Never activate a stopped firewall; report it instead.
    return bus.call_sync(FIREWALLD, '/org/fedoraproject/FirewallD1', ZONE, method,
                         GLib.Variant(signature, args) if signature else None, None,
                         Gio.DBusCallFlags.NO_AUTO_START, 15000, None).unpack()


def firewall(method, *args, failure):
    try:
        import gi
        gi.require_version('Gio', '2.0')
        from gi.repository import Gio, GLib
    except (ImportError, ValueError) as error:
        raise PortError('firewalld is not installed.') from error
    try:
        return dbus(method, *args)
    except GLib.Error as error:
        name = Gio.DBusError.get_remote_error(error) or ''
        if name in ('org.freedesktop.DBus.Error.ServiceUnknown', 'org.freedesktop.DBus.Error.NameHasNoOwner'):
            raise PortError('The firewall is not running.') from None
        if 'NotAuthorizedException' in name:
            raise PortError('Firewall access requires an active local administrator session.') from None
        if error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.TIMED_OUT) \
                or name in ('org.freedesktop.DBus.Error.NoReply', 'org.freedesktop.DBus.Error.Timeout'):
            raise PortError('The firewall did not respond. Try again.') from None
        # firewalld messages can name zones and rules; keep the drawer's wording.
        raise PortError(failure) from None


def rule(network, port):
    return (f'rule family="ipv4" source address="{network.network}" destination address="{network.ip}" '
            f'port port="{port}" protocol="tcp" accept')


def networks():
    """Usable local IPv4 interface addresses by interface name."""
    try:
        result = subprocess.run([IP, '-j', '-4', 'address', 'show'], capture_output=True, text=True,
                                timeout=5, check=True)
        links = json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        raise PortError('Could not read network addresses. Try again.') from error
    found = {}
    for link in links if isinstance(links, list) else []:
        for info in link.get('addr_info') or []:
            try:
                value = ipaddress.IPv4Interface(f"{info['local']}/{info['prefixlen']}")
            except (KeyError, TypeError, ValueError):
                continue
            if value.ip.is_unspecified or value.ip.is_loopback or value.ip.is_multicast \
                    or value.network.prefixlen in (0, 32):
                continue
            found.setdefault(link.get('ifname'), []).append(value)
    return found


def active_zones():
    (zones,) = firewall('getActiveZones', failure='Could not read the firewall. Try again.')
    return {zone: list(value.get('interfaces', [])) for zone, value in zones.items()}


def state():
    """Return addresses, interface zones and drawer-shaped rules that match a current address."""
    addresses, zones, rows = networks(), {}, []
    for zone, interfaces in active_zones().items():
        names = [name for name in interfaces if name in addresses]
        zones.update(dict.fromkeys(interfaces, zone))
        if not names:
            continue
        (listed,) = firewall('getRichRules', '(s)', zone, failure='Could not read the firewall. Try again.')
        for line in listed:
            match = RULE.fullmatch(line.strip())
            if not match:
                continue
            for name in names:
                if any(str(value.network) == match[1] and str(value.ip) == match[2] for value in addresses[name]):
                    rows.append({'interface': name, 'port': int(match[3]), 'address': match[2],
                                 'zone': zone, 'rule': line.strip()})
    return addresses, zones, rows


def public(rows):
    return sorted(({key: row[key] for key in ('interface', 'port', 'address', 'zone')} for row in rows),
                  key=lambda row: (row['interface'], row['port']))


def handle(request):
    if not isinstance(request, dict) or set(request) - {'op', 'interface', 'port'}:
        raise PortError('Invalid port request.')
    op = request.get('op')
    if op not in ('status', 'open', 'close'):
        raise PortError('Unknown port action.')
    if op != 'status':
        port, interface = request.get('port'), request.get('interface')
        if type(port) is not int or not 1 <= port <= 65535:
            raise PortError('Enter a port from 1 to 65535.')
        if not isinstance(interface, str) or not INTERFACE.fullmatch(interface):
            raise PortError('Invalid network interface.')
    addresses, zones, rows = state()
    if op == 'open':
        if any(row['interface'] == interface and row['port'] == port for row in rows):
            raise PortError('This port is already open.')
        if interface not in addresses:
            raise PortError('This network has no usable local IPv4 address.')
        if interface not in zones:
            raise PortError('This network has no firewall zone.')
        network = addresses[interface][0]
        # A zero timeout keeps the runtime rule until reload/reboot.
        firewall('addRichRule', '(ssi)', zones[interface], rule(network, port), 0,
                 failure='Could not open the port. Try again.')
        rows.append({'interface': interface, 'port': port, 'address': str(network.ip), 'zone': zones[interface]})
    elif op == 'close':
        closing = {row['rule']: row['zone'] for row in rows if row['interface'] == interface and row['port'] == port}
        for text, zone in closing.items():
            firewall('removeRichRule', '(ss)', zone, text, failure='Could not close the port. Try again.')
        rows = [row for row in rows if row['rule'] not in closing]
    return public(rows)


def main():
    try:
        request = json.loads(sys.stdin.readline(513))
    except ValueError:
        request = None
    try:
        result = {'ok': True, 'ports': handle(request), 'error': ''}
    except PortError as error:
        result = {'ok': False, 'error': str(error)}
    print(json.dumps(result), flush=True)


if __name__ == '__main__':
    main()

#!/usr/bin/python3 -I
"""Authenticated, runtime-only TCP/IPv4 access through UFW's input chain."""
import ipaddress
import json
import re
import shlex
import signal
import subprocess
import sys
import uuid
from pathlib import Path

NAME = 'org.dotfiles.Ports1'
OBJECT = '/org/dotfiles/Ports1'
CHAIN = 'ufw-user-input'
TAG = re.compile(r'desktop-ports:[0-9]+:[0-9a-f]{32}\Z')
XML = f'''<node><interface name="{NAME}"><method name="Request">
<arg name="request" type="s" direction="in"/><arg name="response" type="s" direction="out"/>
</method></interface></node>'''


class InactiveFirewall(ValueError):
    pass


def command(*args):
    try:
        return subprocess.run(['/usr/bin/iptables', '-w', '2', *args], capture_output=True,
                              text=True, timeout=4, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        raise ValueError('Could not contact UFW. Try again.') from error


def installed_rules():
    try:
        enabled = re.search(r'^ENABLED=yes\s*$', Path('/etc/ufw/ufw.conf').read_text(), re.MULTILINE)
    except OSError:
        enabled = False
    if not enabled:
        raise InactiveFirewall('UFW is not active. Enable it before opening ports.')
    result = command('-S', CHAIN)
    if result.returncode:
        raise InactiveFirewall('UFW is not active. Enable it before opening ports.')
    return [shlex.split(line) for line in result.stdout.splitlines() if line.startswith('-A ')]


def own_rule(rule):
    try:
        return rule[:2] == ['-A', CHAIN] and TAG.fullmatch(rule[rule.index('--comment') + 1]) is not None
    except (ValueError, IndexError):
        return False


def remove_rule(rule):
    # iptables normalizes address/module order; resolve our unguessable tag to
    # its current complete specification instead of deleting by a rule number.
    tag = rule[rule.index('--comment') + 1]
    for current in installed_rules():
        if own_rule(current) and current[current.index('--comment') + 1] == tag:
            result = command('-D', *current[1:])
            if result.returncode and current in installed_rules():
                raise ValueError('Could not close the port. Try again.')


def rule_for(network, port, uid):
    return ['-A', CHAIN, '-i', network['interface'], '-s', network['subnet'], '-d', network['address'],
            '-p', 'tcp', '--dport', str(port), '-m', 'comment', '--comment',
            f'desktop-ports:{uid}:{uuid.uuid4().hex}', '-j', 'ACCEPT']


def port_number(value):
    if type(value) is not int or not 1 <= value <= 65535:
        raise ValueError('Enter a port from 1 to 65535.')
    return value


def network_for(client, interface, NM):
    if not isinstance(interface, str) or not re.fullmatch(r'[\w.:-]{1,15}', interface):
        raise ValueError('Choose a connected local network.')
    device = client.get_device_by_iface(interface)
    if not device or device.get_device_type() not in (NM.DeviceType.WIFI, NM.DeviceType.ETHERNET) \
            or device.get_state() != NM.DeviceState.ACTIVATED:
        raise ValueError('Choose a connected Wi-Fi or Ethernet network.')
    active, config = device.get_active_connection(), device.get_ip4_config()
    if not active or not config:
        raise ValueError('This network has no local IPv4 address.')
    for address in config.get_addresses():
        value = ipaddress.IPv4Interface(f'{address.get_address()}/{address.get_prefix()}')
        if value.ip.is_unspecified or value.ip.is_loopback or value.ip.is_multicast or value.network.prefixlen in (0, 32):
            continue
        return {'interface': interface, 'connection': active.get_path(), 'address': str(value.ip), 'subnet': str(value.network)}
    raise ValueError('This network has no usable local IPv4 address.')


class Ports:
    def __init__(self, network):
        self.network = network
        self.entries = []

    def reconcile(self):
        rules = installed_rules()
        tags = {rule[rule.index('--comment') + 1] for rule in rules if own_rule(rule)}
        for entry in self.entries[:]:
            try:
                connected = self.network(entry['interface']) == entry['network']
            except ValueError:
                connected = False
            if entry['rule'][entry['rule'].index('--comment') + 1] not in tags:
                self.entries.remove(entry)
            elif not connected:
                remove_rule(entry['rule'])
                self.entries.remove(entry)

    def close_all(self):
        # Also recovers untracked rules after a service crash/restart.
        for rule in installed_rules():
            if own_rule(rule):
                remove_rule(rule)
        self.entries.clear()

    def handle(self, request, uid, authorize):
        if not isinstance(request, dict) or set(request) - {'op', 'interface', 'port'}:
            raise ValueError('Invalid port request.')
        op = request.get('op')
        if op not in ('status', 'open', 'close'):
            raise ValueError('Unknown port action.')
        if op != 'status':
            port = port_number(request.get('port'))
            interface = request.get('interface')
            if not isinstance(interface, str) or not re.fullmatch(r'[\w.:-]{1,15}', interface):
                raise ValueError('Invalid network interface.')
            if not authorize():
                raise ValueError('Port changes require an active local administrator session.')
        # A missing UFW chain proves the allowances are gone too.
        try:
            self.reconcile()
        except ValueError:
            if not command('-S', CHAIN).returncode:
                raise
            self.entries.clear()
            raise
        if op == 'open':
            network = dict(self.network(interface))
            if any(e['uid'] == uid and e['interface'] == interface and e['port'] == port for e in self.entries):
                raise ValueError('This port is already open.')
            if sum(e['uid'] == uid for e in self.entries) >= 16:
                raise ValueError('Close a port before opening another (maximum 16).')
            rule = rule_for(network, port, uid)
            # Record before readback so failed validation is still cleaned up.
            entry = {'uid': uid, 'interface': interface, 'port': port, 'network': network, 'rule': rule}
            self.entries.append(entry)
            try:
                result = command('-I', CHAIN, '1', *rule[2:])
                if result.returncode:
                    raise ValueError('Could not open the port. Try again.')
            except ValueError:
                remove_rule(rule)
                self.entries.remove(entry)
                raise
            self.reconcile()
            if entry not in self.entries:
                raise ValueError('The network changed before the port could be opened.')
        elif op == 'close':
            for entry in self.entries[:]:
                if entry['uid'] == uid and entry['interface'] == interface and entry['port'] == port:
                    remove_rule(entry['rule'])
                    self.entries.remove(entry)
        return [{'interface': e['interface'], 'port': e['port'], 'address': e['network']['address']}
                for e in self.entries if e['uid'] == uid]


def serve():
    import gi
    gi.require_version('NM', '1.0')
    from gi.repository import NM, Gio, GLib

    client = NM.Client.new(None)
    ports = Ports(lambda interface: network_for(client, interface, NM))
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    loop = GLib.MainLoop()
    watches = []

    def reconcile(*_):
        if ports.entries:
            try:
                ports.reconcile()
            except ValueError:
                # Keep ownership for retry; never claim an unsuccessful close.
                pass
        return GLib.SOURCE_CONTINUE

    def watch(*_):
        for obj, handler in watches:
            obj.disconnect(handler)
        watches.clear()
        for device in client.get_devices():
            for property_name in ('state', 'active-connection', 'ip4-config'):
                watches.append((device, device.connect('notify::' + property_name, changed)))
            config = device.get_ip4_config()
            if config:
                watches.append((config, config.connect('notify', reconcile)))
        reconcile()

    def changed(*_):
        watch()

    def authorized(sender):
        parameters = GLib.Variant('((sa{sv})sa{ss}us)', (
            ('system-bus-name', {'name': GLib.Variant('s', sender)}),
            'org.dotfiles.ports.manage', {}, 0, ''))
        result = bus.call_sync('org.freedesktop.PolicyKit1', '/org/freedesktop/PolicyKit1/Authority',
                               'org.freedesktop.PolicyKit1.Authority', 'CheckAuthorization', parameters,
                               GLib.VariantType.new('((bba{ss}))'), Gio.DBusCallFlags.NONE, 5000, None)
        return result.unpack()[0][0]

    def request(connection, sender, path, interface, method, parameters, invocation):
        try:
            raw = parameters.unpack()[0]
            if len(raw) > 512:
                raise ValueError('Invalid port request.')
            uid = bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                                'GetConnectionUnixUser', GLib.Variant('(s)', (sender,)),
                                GLib.VariantType.new('(u)'), Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
            rows = ports.handle(json.loads(raw), uid, lambda: authorized(sender))
            result = {'ok': True, 'ports': rows, 'error': ''}
        except (ValueError, GLib.Error):
            # Do not expose internal D-Bus/command output to callers.
            error = sys.exception()
            result = {'ok': False, 'error': str(error) if isinstance(error, ValueError) else 'Port service unavailable. Try again.'}
        invocation.return_value(GLib.Variant('(s)', (json.dumps(result),)))

    def stop():
        try:
            ports.close_all()
        except ValueError:
            pass
        loop.quit()
        return GLib.SOURCE_REMOVE

    try:
        ports.close_all()
    except InactiveFirewall:
        # UFW may be inactive. Status reports that without enabling it.
        pass
    bus.register_object(OBJECT, Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0], request, None, None)
    owner = Gio.bus_own_name_on_connection(bus, NAME, Gio.BusNameOwnerFlags.NONE, None, None)
    client.connect('notify::active-connections', watch)
    client.connect('device-added', watch)
    client.connect('device-removed', watch)
    watch()
    # Reconcile externally removed rules (for example ufw reload). Never re-add.
    GLib.timeout_add_seconds(5, reconcile)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, stop)
    try:
        loop.run()
    finally:
        stop()
        Gio.bus_unown_name(owner)


def call(request):
    from gi.repository import Gio, GLib
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        result = bus.call_sync(NAME, OBJECT, NAME, 'Request', GLib.Variant('(s)', (json.dumps(request),)),
                               GLib.VariantType.new('(s)'), Gio.DBusCallFlags.NONE, 15000, None)
        return json.loads(result.unpack()[0])
    except (GLib.Error, ValueError):
        return {'ok': False, 'error': 'Port service unavailable. Install the UFW desktop port service.'}


if __name__ == '__main__':
    if sys.argv[1:] == ['--serve']:
        serve()
    elif sys.argv[1:] == ['--cleanup']:
        try:
            Ports(None).close_all()
        except InactiveFirewall:
            pass
    else:
        try:
            request = json.loads(sys.stdin.readline(513))
            print(json.dumps(call(request)), flush=True)
        except ValueError:
            print(json.dumps({'ok': False, 'error': 'Invalid port request.'}), flush=True)

[Unit]
Description=Temporary local-network ports through UFW
After=NetworkManager.service ufw.service
Wants=NetworkManager.service

[Service]
Type=dbus
BusName=org.dotfiles.Ports1
ExecStart=/usr/local/libexec/desktop-ports --serve
ExecStopPost=/usr/local/libexec/desktop-ports --cleanup
Restart=on-failure
RestartSec=1
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

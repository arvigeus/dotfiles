#!/usr/bin/python3 -I
"""Select daily power modes at startup and on UPower source edges via PPD."""
import sys

UPOWER = 'org.freedesktop.UPower'
UPOWER_PATH = '/org/freedesktop/UPower'
PPD = 'org.freedesktop.UPower.PowerProfiles'
PPD_PATH = '/org/freedesktop/UPower/PowerProfiles'
PROPERTIES = 'org.freedesktop.DBus.Properties'


class SourcePolicy:
    def __init__(self, bus):
        self.bus = bus
        self.previous = None

    def observe(self):
        on_battery = self.bus.on_battery()
        if not isinstance(on_battery, bool):
            raise RuntimeError('UPower did not report a valid power source')
        if self.previous == on_battery:
            return
        # Reconcile the initial source too: an unplug while powered off cannot
        # produce an edge in this process. Later reads preserve manual choices
        # until the source actually changes.
        active = self.bus.active_profile()
        target = 'power-saver' if on_battery else 'balanced'
        if active in ('balanced', 'power-saver') and active != target:
            self.bus.select_profile(target)
            if self.bus.active_profile() != target:
                raise RuntimeError('The power service did not confirm ' + target)
        self.previous = on_battery


class Bus:
    def __init__(self):
        from gi.repository import Gio
        self.connection = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def call(self, service, path, method, signature, values):
        from gi.repository import Gio, GLib
        return self.connection.call_sync(service, path, PROPERTIES, method,
            GLib.Variant(signature, values), None, Gio.DBusCallFlags.NO_AUTO_START,
            15000, None).unpack()

    def on_battery(self):
        return self.call(UPOWER, UPOWER_PATH, 'Get', '(ss)', (UPOWER, 'OnBattery'))[0]

    def active_profile(self):
        return self.call(PPD, PPD_PATH, 'Get', '(ss)', (PPD, 'ActiveProfile'))[0]

    def select_profile(self, value):
        from gi.repository import GLib
        self.call(PPD, PPD_PATH, 'Set', '(ssv)',
                  (PPD, 'ActiveProfile', GLib.Variant('s', value)))


def main():
    from gi.repository import Gio, GLib
    bus = Bus()
    policy = SourcePolicy(bus)
    loop = GLib.MainLoop()
    failed = False

    def changed(connection, sender, path, interface, signal, parameters, user_data=None):
        nonlocal failed
        name, values, invalidated = parameters.unpack()
        if name != UPOWER or ('OnBattery' not in values and 'OnBattery' not in invalidated):
            return
        try:
            policy.observe()
        except (GLib.Error, RuntimeError) as error:
            print(error, file=sys.stderr, flush=True)
            failed = True
            loop.quit()

    # Subscribe before reconciling the initial source so a startup edge is not lost.
    bus.connection.signal_subscribe(UPOWER, PROPERTIES, 'PropertiesChanged',
        UPOWER_PATH, UPOWER, Gio.DBusSignalFlags.NONE, changed)
    policy.observe()
    loop.run()
    return 1 if failed else 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as error:
        raise SystemExit(str(error))

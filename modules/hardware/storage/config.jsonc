{
    "bootloader_config": {
        "bootloader": "Efistub",
        "removable": false,
        "uki": true
    },
    "packages": [
        "udisks2"
    ]
    // Archinstall 4.5 deliberately skips periodic TRIM for Btrfs.
    // Leave this disabled to follow that default; uncomment to override it.
    // , "services": ["fstrim.timer"]
}
